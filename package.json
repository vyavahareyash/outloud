{
	"name": "outloud",
	"version": "0.1.0",
	"description": "Chrome extension to highlight text and read it aloud using local Ollama Phonon model",
	"homepage": "https://chromewebstore.google.com/detail/ccbgbiimgikekfeeacgimhhbdchlfmpn",
	"type": "module",
	"scripts": {
		"build": "node build.mjs",
		"build:prod": "node build.mjs --prod",
		"pack": "node build.mjs --prod && node scripts/pack.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"type-check": "tsc --noEmit",
		"lint": "biome check src tests scripts",
		"format": "biome format --write src tests scripts",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@types/chrome": "^0.0.308",
		"@types/node": "^22.0.0",
		"esbuild": "^0.25.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"typescript": "^5.8.0",
		"vitest": "^3.0.0"
	}
}
